.approve-milestone-wrapper { padding: 1rem .25rem 2rem; }
.approve-milestone-header { align-items: flex-start; }
.approve-milestone-card { padding: 1rem; border-radius: 14px; }
.approve-milestone-section-heading { align-items: flex-start; flex-direction: column; }
.approve-milestone-facts { grid-template-columns: 1fr 1fr; }
.approve-milestone-file { align-items: flex-start; flex-wrap: wrap; }
.approve-milestone-file-info { width: calc(100% - 52px); }
.approve-milestone-file-actions { margin-left: 51px; }

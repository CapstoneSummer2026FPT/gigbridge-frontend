 * return (
 *   <select value={currentLanguage} onChange={(e) => changeLanguage(e.target.value)}>
 *     {availableLanguages.map(lang => (
 *       <option key={lang} value={lang}>{lang}</option>
 *     ))}
 *   </select>
 * );
 * ```

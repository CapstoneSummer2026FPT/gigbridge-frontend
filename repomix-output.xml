.approve-milestone-layout { grid-template-columns: 1fr; }
.approve-milestone-sidebar { grid-row: 1; }
.approve-milestone-sidebar-sticky { position: static; }
.approve-milestone-main { grid-row: 2; }
.approve-milestone-payment { order: -2; }
.approve-milestone-decision { order: -1; }

.approve-milestone-section-heading h2,
.approve-milestone-status { display: inline-flex; align-items: center; gap: .4rem; flex: 0 0 auto; padding: .45rem .65rem; color: #fbbf24; border: 1px solid rgba(245,158,11,.25); border-radius: 999px; background: rgba(245,158,11,.1); font-size: .78rem; font-weight: 700; }
.approve-milestone-status--3,
.approve-milestone-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin-top: 1.25rem; padding-top: 1.15rem; border-top: 1px solid var(--border, rgba(148,163,184,.18)); }
.approve-milestone-facts div { display: grid; gap: .3rem; }
.approve-milestone-facts span { color: var(--text-secondary, #94a3b8); font-size: .75rem; }
.approve-milestone-facts strong { font-size: .92rem; }
⋮----
.approve-milestone-escrow { padding: .8rem 1rem; border-color: rgba(99,102,241,.25); background: rgba(99,102,241,.08); }
.approve-milestone-escrow-toggle { width: 100%; display: flex; align-items: center; gap: .75rem; padding: 0; border: 0; color: inherit; background: transparent; text-align: left; }
.approve-milestone-escrow-toggle > span:nth-child(2) { display: grid; gap: .1rem; flex: 1; }
.approve-milestone-escrow-toggle small { color: var(--text-secondary, #94a3b8); }
.approve-milestone-escrow-toggle > svg { transition: transform .2s ease; }
.approve-milestone-escrow-toggle > svg.is-open { transform: rotate(180deg); }
.approve-milestone-icon { display: grid; place-items: center; width: 38px; height: 38px; color: #a5b4fc; border-radius: 10px; background: rgba(99,102,241,.16); }
.approve-milestone-escrow-copy { margin: .75rem 0 0 3.15rem; padding-top: .75rem; border-top: 1px solid rgba(99,102,241,.18); color: var(--text-secondary, #cbd5e1); font-size: .86rem; line-height: 1.55; }
⋮----
.approve-milestone-count { padding: .35rem .6rem; color: var(--text-secondary, #94a3b8); border-radius: 999px; background: rgba(148,163,184,.1); font-size: .75rem; }
.approve-milestone-files { display: grid; gap: .65rem; margin-top: 1.15rem; }
.approve-milestone-file { display: flex; align-items: center; gap: .8rem; padding: .8rem; border: 1px solid var(--border, rgba(148,163,184,.16)); border-radius: 12px; background: rgba(148,163,184,.05); }
.approve-milestone-file-icon { display: grid; place-items: center; width: 38px; height: 38px; color: #93c5fd; border-radius: 10px; background: rgba(59,130,246,.12); }
.approve-milestone-file-info { display: grid; gap: .2rem; flex: 1; min-width: 0; }
.approve-milestone-file-info strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .9rem; }
.approve-milestone-file-info span { color: var(--text-secondary, #94a3b8); font-size: .73rem; }
.approve-milestone-file-actions { display: flex; gap: .4rem; }
.approve-milestone-file-actions a,

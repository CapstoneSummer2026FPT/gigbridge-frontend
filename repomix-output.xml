.approve-milestone-payment { background: linear-gradient(145deg, rgba(99,102,241,.18), rgba(15,23,42,.72)); }
.approve-milestone-payment > span { display: flex; align-items: center; gap: .45rem; color: var(--text-secondary, #cbd5e1); font-size: .78rem; font-weight: 700; }
.approve-milestone-payment > div { display: flex; align-items: center; gap: .7rem; margin: .8rem 0 .3rem; }
.approve-milestone-payment strong { font-size: clamp(1.6rem, 3vw, 2rem); letter-spacing: -.04em; }
.approve-milestone-payment small { color: #a5b4fc; }
.approve-milestone-decision > p { margin: .45rem 0 1rem; color: var(--text-secondary, #94a3b8); font-size: .84rem; }
.approve-milestone-options { display: grid; gap: .55rem; }
.approve-milestone-options > button { display: flex; align-items: center; gap: .7rem; width: 100%; padding: .8rem; border: 1px solid var(--border, rgba(148,163,184,.18)); border-radius: 12px; color: inherit; background: rgba(148,163,184,.04); text-align: left; }
.approve-milestone-options > button > span { display: grid; gap: .1rem; }
.approve-milestone-options small { color: var(--text-secondary, #94a3b8); }
.approve-milestone-options button:first-child svg { color: #34d399; }
.approve-milestone-options button:last-child svg { color: #fbbf24; }
.approve-milestone-options .is-approve { border-color: rgba(16,185,129,.48); background: rgba(16,185,129,.1); }
.approve-milestone-options .is-revision { border-color: rgba(245,158,11,.48); background: rgba(245,158,11,.1); }

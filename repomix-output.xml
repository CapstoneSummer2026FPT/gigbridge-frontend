.approve-milestone-empty-files { display: flex; align-items: center; gap: .8rem; margin-top: 1rem; padding: 1rem; color: var(--text-secondary, #94a3b8); border: 1px dashed var(--border, rgba(148,163,184,.25)); border-radius: 12px; }
.approve-milestone-empty-files strong { color: var(--text-primary, #f8fafc); }
.approve-milestone-empty-files p { margin: .2rem 0 0; font-size: .82rem; }

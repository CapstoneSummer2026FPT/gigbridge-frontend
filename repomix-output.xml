.approve-milestone-card { padding: 1.35rem; border: 1px solid var(--border, rgba(148,163,184,.2)); border-radius: 18px; background: color-mix(in srgb, var(--background, #0f172a) 78%, transparent); box-shadow: 0 18px 45px rgba(2,6,23,.1); backdrop-filter: blur(16px); }

.approve-milestone-confirmation { margin-top: .8rem; padding-top: .9rem; border-top: 1px solid var(--border, rgba(148,163,184,.18)); }
.approve-milestone-confirmation > p { display: grid; gap: .25rem; margin: 0; color: var(--text-secondary, #cbd5e1); font-size: .82rem; line-height: 1.45; }
.approve-milestone-confirmation label { display: flex; justify-content: space-between; margin-bottom: .45rem; font-size: .82rem; font-weight: 700; }
.approve-milestone-confirmation label span { color: #fbbf24; font-size: .7rem; text-transform: uppercase; }
.approve-milestone-confirmation textarea { width: 100%; min-height: 105px; padding: .75rem; resize: vertical; border: 1px solid var(--border, rgba(148,163,184,.24)); border-radius: 10px; color: var(--text-primary, #f8fafc); background: rgba(2,6,23,.24); }
.approve-milestone-confirmation textarea::placeholder { color: var(--text-secondary, #64748b); }
.approve-milestone-textarea-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: .6rem; margin-top: .35rem; color: var(--text-secondary, #94a3b8); font-size: .68rem; }
.approve-milestone-textarea-meta small { line-height: 1.35; }
.approve-milestone-textarea-meta span { flex: 0 0 auto; }
.approve-milestone-textarea-meta .is-over { color: #f87171; font-weight: 700; }
.approve-milestone-decision-actions { display: grid; grid-template-columns: auto 1fr; gap: .55rem; margin-top: .8rem; }
.approve-milestone-decision-actions button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 42px; padding: .65rem .8rem; border: 1px solid var(--border, rgba(148,163,184,.22)); border-radius: 10px; color: inherit; background: transparent; font-size: .8rem; font-weight: 750; }
.approve-milestone-decision-actions .is-approve { border-color: transparent; color: #fff; background: #059669; }
.approve-milestone-decision-actions .is-revision { border-color: transparent; color: #111827; background: #fbbf24; }
.approve-milestone-complete { text-align: center; }
.approve-milestone-complete > span { display: grid; place-items: center; width: 48px; height: 48px; margin: 0 auto .7rem; color: #34d399; border-radius: 50%; background: rgba(16,185,129,.12); }
.approve-milestone-complete h2 { margin: 0; font-size: 1.15rem; }
.approve-milestone-complete p { margin: .45rem 0 0; color: var(--text-secondary, #94a3b8); font-size: .82rem; line-height: 1.5; }
.approve-milestone-workspace-button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; padding: .75rem; border: 0; color: var(--text-secondary, #cbd5e1); background: transparent; font-size: .82rem; }
.approve-milestone-workspace-button:hover { color: var(--text-primary, #fff); }
⋮----
.approve-milestone-state { display: grid; place-items: center; align-content: center; min-height: 55vh; text-align: center; }
.approve-milestone-state h1 { margin: 1rem 0 .35rem; font-size: 1.45rem; }
.approve-milestone-state p { max-width: 430px; margin: 0 0 1rem; color: var(--text-secondary, #94a3b8); }
.approve-milestone-state--error > svg { color: #f87171; }
.approve-milestone-spinner { display: inline-block; width: 38px; height: 38px; border: 3px solid rgba(148,163,184,.2); border-top-color: var(--accent-primary, #818cf8); border-radius: 50%; animation: approve-milestone-spin .75s linear infinite; }
.approve-milestone-spinner--small { width: 15px; height: 15px; border-width: 2px; border-top-color: currentColor; }

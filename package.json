{
  "name": "gigbridge-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "vite build",
    "postbuild": "node scripts/audit-build-artifact.mjs",
    "audit:artifact": "node scripts/audit-build-artifact.mjs",
    "audit:deadcode": "knip --no-progress --include files,dependencies,exports",
    "dev": "vite",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "axios": "^1.18.0",
    "clsx": "2.1.1",
    "gsap": "^3.15.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.1",
    "recharts": "2.15.2",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^25.0.1",
    "knip": "^5.88.1",
    "tailwindcss": "4.1.12",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
